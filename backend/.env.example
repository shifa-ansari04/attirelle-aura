# Copy this file to .env and add your own Gemini API key.
GEMINI_API_KEY=replace_with_your_key
# Confirm that this model is enabled for your Google AI Studio project.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=90
# For local development, this default is already configured in main.py.
# For deployment, set this to your exact frontend origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
